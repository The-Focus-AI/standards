{
  // Markdownlint config for Focus.AI Standards
  "config": {
    "default": true,
    // Line length: 120 is practical for docs with URLs and tables
    "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
    // Allow multiple H1 headings (AGENTS.md, best-practices use them)
    "MD025": false,
    // Allow inline HTML in markdown
    "MD033": false
  },
  // Skip generated/cached content
  "ignores": [
    ".firecrawl/**",
    "node_modules/**",
    ".pi/**",
    ".agents/skills/**",
    "reports/**",
    "architecture/**"
  ]
}
