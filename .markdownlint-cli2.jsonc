{
  // Markdownlint config for Focus.AI Standards
  "config": {
    "default": true,
    // Line length: 120 is practical for docs with URLs and tables
    "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
    // Allow multiple H1 headings (AGENTS.md, best-practices use them)
    "MD025": false,
    // Allow inline HTML in markdown
    "MD033": false
  },
  // Skip generated and cached content only. `reports/` and `architecture/` used
  // to be skipped too; they are published documents now, so they are linted like
  // everything else this repository writes.
  "ignores": [
    ".firecrawl/**",
    "node_modules/**",
    ".pi/**",
    ".agents/skills/**",
    "out/**",

    // Vendored skills — copied in from other repositories, listed under
    // "Vendored" in skills/VENDORED.md. They are validated by
    // `mise run skills:check` on the axes that matter for a skill (frontmatter,
    // kebab-case name, reference paths that resolve). Holding someone else's
    // prose to this repo's line-length rule produces noise, and a permanently
    // red gate is one everybody learns to skip.
    //
    // This list MUST match the Vendored table in skills/VENDORED.md.
    // `mise run skills:check` fails if the two drift apart.
    "skills/research-methodology/**",
    "skills/browser-automation/**",
    "skills/nano-banana-imagegen/**",
    "skills/nano-banana-videogen/**",
    "skills/focus-ai-brand/**"
  ]
}
