{
  "version": 1,
  "targets": {
    "vercel-preview": {
      "platform": "vercel",
      "projectId": "prj_REPLACE",
      "teamId": "team_REPLACE",
      "environment": "preview",
      "tokenEnv": "VERCEL_SYNC_TOKEN",
      "source": {
        "config": "fnox.toml",
        "profile": "runtime",
        "tokenEnv": "OP_SERVICE_ACCOUNT_TOKEN"
      },
      "keys": {
        "ANTHROPIC_API_KEY": "ANTHROPIC_API_KEY",
        "CLERK_SECRET_KEY": "CLERK_SECRET_KEY"
      }
    },
    "vercel-production": {
      "platform": "vercel",
      "projectId": "prj_REPLACE",
      "teamId": "team_REPLACE",
      "environment": "production",
      "tokenEnv": "VERCEL_SYNC_TOKEN",
      "source": {
        "config": "fnox.toml",
        "profile": "runtime",
        "tokenEnv": "OP_SERVICE_ACCOUNT_TOKEN"
      },
      "keys": {
        "ANTHROPIC_API_KEY": "ANTHROPIC_API_KEY",
        "CLERK_SECRET_KEY": "CLERK_SECRET_KEY"
      }
    },
    "gcp-preview": {
      "platform": "gcp",
      "projectId": "replace-preview",
      "tokenEnv": "GCP_PREVIEW_ACCESS_TOKEN",
      "source": {
        "config": "fnox.toml",
        "profile": "runtime",
        "tokenEnv": "OP_SERVICE_ACCOUNT_TOKEN"
      },
      "keys": {
        "ANTHROPIC_API_KEY": "app-anthropic-api-key",
        "CLERK_SECRET_KEY": "app-clerk-secret-key"
      }
    },
    "gcp-production": {
      "platform": "gcp",
      "projectId": "replace-production",
      "tokenEnv": "GCP_PRODUCTION_ACCESS_TOKEN",
      "source": {
        "config": "fnox.toml",
        "profile": "runtime",
        "tokenEnv": "OP_SERVICE_ACCOUNT_TOKEN"
      },
      "keys": {
        "ANTHROPIC_API_KEY": "app-anthropic-api-key",
        "CLERK_SECRET_KEY": "app-clerk-secret-key"
      }
    }
  }
}
